{
  "name": "term-spotify",
  "version": "0.1.1",
  "private": true,
  "description": "A terminal Spotify console. Now playing, the queue, and the keys you actually use.",
  "license": "MIT",
  "author": "Daniel Ke",
  "homepage": "https://github.com/DMXL/term-spotify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DMXL/term-spotify.git"
  },
  "bugs": {
    "url": "https://github.com/DMXL/term-spotify/issues"
  },
  "keywords": [
    "spotify",
    "terminal",
    "tui",
    "cli",
    "macos",
    "applescript",
    "now-playing"
  ],
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "bin": {
    "spot": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "login": "tsx src/cli.ts login",
    "probe": "tsx src/cli.ts probe",
    "release": "tsx scripts/release.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
